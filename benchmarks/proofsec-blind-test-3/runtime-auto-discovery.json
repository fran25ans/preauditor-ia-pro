{
  "target": {
    "base_url": "http://127.0.0.1:8082",
    "authorized": true,
    "allow_mutating": false,
    "max_requests": 300,
    "timeout_seconds": 5.0
  },
  "identities": {
    "alpha": {
      "role": "ANALYST",
      "auth": {
        "type": "bearer",
        "token": "t3-alpha-token"
      },
      "attributes": {
        "username": "alpha.python",
        "sub": "usr-a-701",
        "principal_id": "P-1001",
        "tenant": "tenant-red",
        "team": "team-orion"
      }
    },
    "bravo": {
      "role": "ANALYST",
      "auth": {
        "type": "bearer",
        "token": "t3-bravo-token"
      },
      "attributes": {
        "username": "bravo.python",
        "sub": "usr-b-909",
        "principal_id": "P-2002",
        "tenant": "tenant-blue",
        "team": "team-pegasus"
      }
    }
  },
  "discovery": {
    "assets": {
      "list_endpoint": "/gateway/assets",
      "detail_endpoint": "/gateway/assets/{asset_code}",
      "items_path": "edges.node",
      "id_field": "assetCode",
      "owner_fields": [
        "binding.principal.id",
        "binding.tenantRef"
      ],
      "owner_marker_fields": [
        "binding.principal.id",
        "binding.tenantRef",
        "owner",
        "owner.id",
        "advisor.id",
        "advisorId",
        "managerId",
        "assignedTo",
        "createdBy"
      ]
    },
    "reports": {
      "list_endpoint": "/api/reports",
      "detail_endpoint": "/api/reports/{report_id}",
      "items_path": "data",
      "id_field": "report_id",
      "owner_fields": [
        "acl.owner",
        "relationships.acl.data.owner"
      ],
      "owner_marker_fields": [
        "acl.owner",
        "relationships.acl.data.owner",
        "owner",
        "owner.id",
        "advisor.id",
        "advisorId",
        "managerId",
        "assignedTo",
        "createdBy"
      ]
    },
    "secrets": {
      "list_endpoint": "/profiles/secrets",
      "detail_endpoint": "/profiles/secrets/{secret_ref}",
      "items_path": "collection.entries",
      "id_field": "secretRef",
      "owner_fields": [
        "ownerSub"
      ],
      "owner_marker_fields": [
        "ownerSub",
        "owner",
        "owner.id",
        "advisor.id",
        "advisorId",
        "managerId",
        "assignedTo",
        "createdBy"
      ]
    }
  }
}
